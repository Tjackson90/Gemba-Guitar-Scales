{
  "name": "gemba-scales",
  "version": "0.1.0",
  "description": "Gemba Scales - see any scale across the guitar neck (web + Capacitor Android).",
  "main": "scales-app/index.html",
  "scripts": {
    "assets": "node scripts/make-assets.js",
    "test": "node tests/run.js",
    "sync": "npx cap sync android",
    "open:android": "npx cap open android",
    "build:android": "node scripts/build-android.js",
    "install:android": "node scripts/build-android.js && adb install -r android/app/build/outputs/apk/debug/app-debug.apk"
  },
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@capacitor/android": "^8.2.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.2.0"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.2.0",
    "sharp": "^0.35.5"
  }
}
